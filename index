        <div className="flex items-start justify-between gap-3 mb-1">
          <div>
            <p className="text-[11px] uppercase tracking-widest text-teal-600/70 font-semibold">💬 Assistenza</p>
            <h2 id="titolo-supporto" className="text-xl font-bold text-teal-900">Contatti e supporto</h2>
