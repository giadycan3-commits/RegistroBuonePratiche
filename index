  const [tipo, setTipo] = useState(TIPI_RICHIESTA[0]);
  const [testo, setTesto] = useState("");
  const [tecnici, setTecnici] = useState(true);
  const [esitoCopia, setEsitoCopia] = useState("");

  useEffect(() => {
    const onKey = e => { if (e.key === "Escape") onClose(); };
    window.addEventListener("keydown", onKey);
    return () => window.removeEventListener("keydown", onKey);
  }, [onClose]);

  const oggetto = `[Wizard Buone Pratiche] ${tipo}`;
  const corpo = testo.trim() + (tecnici ? `\n\n---\nPassaggio del wizard: ${passaggio}\nBrowser: ${navigator.userAgent}` : "");
  const pronto = DESTINATARI_SUPPORTO.length > 0 && testo.trim().length > 0;
  const mailto = `mailto:${DESTINATARI_SUPPORTO.join(",")}?subject=${encodeURIComponent(oggetto)}&body=${encodeURIComponent(corpo)}`;

  const copia = async () => {
    try {
      await navigator.clipboard.writeText(`A: ${ELENCO_DESTINATARI}\nOggetto: ${oggetto}\n\n${corpo}`);
      setEsitoCopia("✓ Copiato!");
    } catch (e) {
      setEsitoCopia(`Copia non disponibile: scrivi a ${ELENCO_DESTINATARI} dal tuo programma di posta.`);
    }
    setTimeout(() => setEsitoCopia(""), 3000);
  };

  return (
    <div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-3 sm:p-6 bg-slate-900/30 backdrop-blur-sm" onClick={onClose}>
      <div role="dialog" aria-modal="true" aria-labelledby="titolo-supporto" onClick={e => e.stopPropagation()}
        className="relative w-full max-w-lg max-h-[90vh] overflow-y-auto rounded-3xl bg-white shadow-2xl shadow-teal-900/20 border border-white p-6">
