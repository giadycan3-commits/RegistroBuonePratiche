          <button type="button" onClick={onClose} aria-label="Chiudi"
            className="shrink-0 w-8 h-8 rounded-full text-slate-400 hover:bg-teal-50 hover:text-teal-700 transition-colors">✕</button>
        </div>
        <p className="text-sm text-slate-500 mb-4">
          Hai un dubbio o qualcosa non funziona? Dai un'occhiata alle risposte rapide, poi scrivi ai referenti e alle referenti del progetto.
        </p>

        <div className="space-y-2 mb-5">
          {DOMANDE_FREQUENTI.map(([domanda, risposta]) => (
            <details key={domanda} className="rounded-2xl border border-teal-100 bg-teal-50/40 px-3 py-2">
              <summary className="cursor-pointer text-sm font-medium text-teal-800">{domanda}</summary>
              <p className="text-xs text-slate-600 mt-2">{risposta}</p>
            </details>
          ))}
        </div>

        <h3 className="font-semibold text-teal-900/80 mb-2">✉️ Scrivi al supporto</h3>
        {DESTINATARI_SUPPORTO.length === 0 && (
          <p className="text-xs text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-2 mb-3">
            Contatto non ancora configurato: chi pubblica il wizard deve inserire l'indirizzo in <code>EMAIL_SUPPORTO</code>.
          </p>
        )}
        <Field label="Tipo di richiesta">
          <select className={INPUT} value={tipo} onChange={e => setTipo(e.target.value)}>
            {TIPI_RICHIESTA.map(t => <option key={t}>{t}</option>)}
          </select>
        </Field>
        <Field label="Messaggio" hint="Non inserire nomi o altri dati personali di alunni, alunne, colleghi e colleghe.">
          <textarea className={INPUT + " min-h-28"} maxLength={1500} value={testo} onChange={e => setTesto(e.target.value)} />
        </Field>
        <label className="flex items-start gap-2 text-xs text-slate-600 cursor-pointer">
          <input type="checkbox" className="mt-0.5 accent-teal-600" checked={tecnici} onChange={() => setTecnici(v => !v)} />
          <span>Includi il passaggio del wizard e il browser in uso (aiuta a risolvere il problema).</span>
        </label>

        <div className="flex flex-wrap items-center gap-2 mt-4">
          {pronto
            ? <a href={mailto} className={BTN_PRIMARIO + " inline-block text-center"}>✉️ Apri la email</a>
            : <button type="button" disabled className={BTN_PRIMARIO}>✉️ Apri la email</button>}
          <button type="button" disabled={!pronto} onClick={copia} className={BTN_SECONDARIO}>📋 Copia il messaggio</button>
          {esitoCopia && <span className="text-xs text-teal-700">{esitoCopia}</span>}
        </div>
        <p className="text-[11px] text-slate-400 mt-3">
          Si apre il tuo programma di posta con il messaggio già pronto: l'invio parte dal tuo indirizzo.
          Se non si apre nulla, usa «Copia il messaggio» e incollalo nella tua posta{DESTINATARI_SUPPORTO.length ? <>, indirizzandolo a <b>{ELENCO_DESTINATARI}</b></> : ""}.
        </p>
        <p className="text-[11px] text-slate-400 mt-2">
          Per richieste sui tuoi dati personali scrivi al Responsabile della protezione dei dati:{" "}
          <a className="underline hover:text-teal-600" href={`mailto:${EMAIL_PRIVACY}`}>{EMAIL_PRIVACY}</a>.
        </p>
      </div>
    </div>
  );
}

export default function App() {
  const [step, setStep] = useState(0);
  const [d, setD] = useState(caricaBozza);
