    titolo: d.titolo.trim(), autore: d.autore.trim(), email: d.email.trim().toLowerCase(),
    istituzione: d.istituzione.trim(), regione: d.regione,
    ordini: d.ordini.map(o => ORDINI[o]).join(", "), etaMin: d.etaMin, etaMax: d.etaMax,
