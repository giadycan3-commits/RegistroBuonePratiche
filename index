const normalizza = s =>
  String(s).toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[’‘]/g, "'");

function suggerisci(testo, mappa, max) {
  const t = normalizza(testo);
  return Object.entries(mappa)
    .map(([chiave, pattern]) => [chiave, pattern.reduce((s, p) => s + (new RegExp("\\b" + p).test(t) ? 1 : 0), 0)])
    .filter(([, punti]) => punti > 0)
    .sort((a, b) => b[1] - a[1])
    .slice(0, max)
    .map(([chiave]) => chiave);
}

