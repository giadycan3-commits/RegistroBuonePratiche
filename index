  const [copiato, setCopiato] = useState(false);
  const [avviso, setAvviso] = useState("");
  const [supportoAperto, setSupportoAperto] = useState(false);

  useEffect(() => {
    try { window.localStorage.setItem(STORAGE_KEY, JSON.stringify(d)); } catch (e) { /* ignora */ }
  }, [d]);

  /* ---- invio al foglio privato del progetto ---- */
  const [stato, setStato] = useState(""); // "" | "invio" | "ok" | "errore"
  const [msgInvio, setMsgInvio] = useState("");

  const generaId = () =>
    window.crypto && window.crypto.randomUUID
      ? window.crypto.randomUUID()
      : `bp-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 10)}`;

  const invia = async () => {
    if (!ENDPOINT_INVIO) return;
    const id = d.idInvio || generaId();
    const corpo = JSON.stringify({
      versione: 1,
      sito: "", // campo trappola anti-bot: deve restare vuoto
      id,
      riga: costruisciRiga(d),
      consensi: { privacy: d.consensoPrivacy, informativa: d.consensoInformativa, versioneInformativa: VERSIONE_INFORMATIVA },
    });
    const intestazioni = { "Content-Type": "text/plain;charset=utf-8" };
    const segna = () => setD(p => ({ ...p, idInvio: id, inviataIl: new Date().toLocaleString("it-IT") }));
    setStato("invio");
    setMsgInvio("");
    try {
      const res = await fetch(ENDPOINT_INVIO, { method: "POST", headers: intestazioni, body: corpo });
      const esito = await res.json();
      if (esito && esito.ok) {
        segna(); setStato("ok"); setMsgInvio("I referenti e le referenti del progetto hanno ricevuto la scheda.");
      } else {
        setD(p => ({ ...p, idInvio: id }));
        setStato("errore"); setMsgInvio((esito && esito.messaggio) || "Invio non riuscito. Riprova più tardi.");
      }
    } catch (e) {
      // risposta non leggibile dal browser: l'invio è idempotente (stesso ID), quindi si ritenta senza leggere la risposta
      try {
        await fetch(ENDPOINT_INVIO, { method: "POST", mode: "no-cors", headers: intestazioni, body: corpo });
        segna(); setStato("ok");
        setMsgInvio("Scheda inviata. Non è stato possibile leggere la conferma del server: se non ricevi risposta dai referenti e dalle referenti, riprova a inviare.");
      } catch (e2) {
        setD(p => ({ ...p, idInvio: id }));
        setStato("errore"); setMsgInvio("Connessione non riuscita: controlla la rete e riprova.");
      }
    }
  };

  const azzeraTutto = () => { setD(INIZIALE); setStep(0); setStato(""); setMsgInvio(""); };

  const upd = (k, v) => setD(p => ({ ...p, [k]: typeof v === "function" ? v(p[k]) : v }));
  const toggleIn = (k, v) => upd(k, arr => (arr.includes(v) ? arr.filter(x => x !== v) : [...arr, v]));
  const addUnique = (k, v) => upd(k, arr => (arr.includes(v) ? arr : [...arr, v]));
  const toggleDisc = (o, dis) => upd("discipline", p => {
    const cur = p[o] || [];
    return { ...p, [o]: cur.includes(dis) ? cur.filter(x => x !== dis) : [...cur, dis] };
  });
  const addDisc = (o, dis) => upd("discipline", p => {
    const cur = p[o] || [];
    return cur.includes(dis) ? p : { ...p, [o]: [...cur, dis] };
  });

  const hasInfanzia = d.ordini.includes("infanzia");
  const ordiniConDiscipline = d.ordini.filter(o => o !== "infanzia");
  const attivita = `${d.titolo} ${d.abstract} ${d.descrizione}`;

  const suggCompetenze = useMemo(() => suggerisci(attivita, KEYWORD_COMPETENZE, 6), [attivita]);
  const suggCompetenzeNomi = useMemo(() => suggCompetenze.map(competenzaDaCodice).filter(Boolean), [suggCompetenze]);
  const suggTag = useMemo(() => suggerisci(attivita, KEYWORD_TAG, 8).filter(t => !d.tags.includes(t)).slice(0, 6), [attivita, d.tags]);
  const suggMet = useMemo(() => suggerisci(attivita, KEYWORD_METODOLOGIE, 6).filter(m => !d.metodologie.includes(m)).slice(0, 4), [attivita, d.metodologie]);

  const areeSelezionate = DIGCOMP.filter(a => a.competenze.some(c => d.digcomp.includes(c))).map(a => a.area);

  const parole = d.abstract.trim() ? d.abstract.trim().split(/\s+/).length : 0;

  const steps = ["Anagrafica","Descrizione","Destinatari","Discipline","Metodologie","Competenze","Invio"];

  /* ---- validazione ---- */
  const etaMin = d.etaMin === "" ? null : Number(d.etaMin);
  const etaMax = d.etaMax === "" ? null : Number(d.etaMax);
  const datiRilevati = rilevaDatiPersonali(`${d.titolo} ${d.abstract} ${d.descrizione}`);
  const errori = [
    [
      !d.titolo.trim() && "Inserisci il titolo.",
