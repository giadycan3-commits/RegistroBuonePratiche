              <h2 className="text-xl font-bold text-teal-900 mb-5">Descrizione</h2>
              <Field label="Abstract" hint={`Breve sintesi della pratica (max ${MAX_PAROLE_ABSTRACT} parole).`}>
                <textarea className={INPUT + " min-h-28"} value={d.abstract} onChange={e => upd("abstract", e.target.value)} />
                <p className={`text-xs mt-1 text-right ${parole > MAX_PAROLE_ABSTRACT ? "text-rose-600 font-semibold" : "text-slate-400"}`}>
                  {parole}/{MAX_PAROLE_ABSTRACT} parole
                </p>
              </Field>
              <Field label="Descrizione dell'attività" hint="Descrivi fasi, strumenti, materiali: l'analisi di questo testo alimenta i suggerimenti automatici di tag, competenze DigComp e metodologie. Non inserire nomi o dati personali di alunni e alunne, famiglie, colleghi e colleghe.">
                <textarea className={INPUT + " min-h-40"} value={d.descrizione} onChange={e => upd("descrizione", e.target.value)} />
              </Field>
              {datiRilevati.length > 0 && (
                <p className="text-xs text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-2 mb-4" role="alert">
                  ⚠️ Nel testo sembrano esserci {datiRilevati.join(", ")}: rimuovili prima dell'invio.
                </p>
              )}
              <Field label="Tag">
                <div className="flex flex-wrap gap-1.5">
                  {d.tags.map(t => <Chip key={t} label={t} selected={true} onClick={() => toggleIn("tags", t)} />)}
                </div>
                <AggiungiManuale placeholder="+ aggiungi tag…" onAdd={t => addUnique("tags", t)} />
                <div className="flex flex-wrap gap-1.5 mt-2">
                  {TAG_SUGGERITI.filter(t => !d.tags.includes(t) && !suggTag.includes(t)).slice(0, 8).map(t => (
                    <button key={t} type="button" onClick={() => addUnique("tags", t)}
                      className="px-2 py-0.5 rounded-full border border-dashed border-slate-300 text-[11px] text-slate-500 hover:border-teal-400 hover:text-teal-600">
                      + {t}
                    </button>
                  ))}
                </div>
              </Field>
              <Suggerimento title="Tag suggeriti in base alla descrizione" items={suggTag} onPick={t => addUnique("tags", t)} />
            </div>
          )}

          {/* STEP 2 */}
          {step === 2 && (
            <div>
              <h2 className="text-xl font-bold text-teal-900 mb-5">Destinatari</h2>
              <Field label="Ordine/i di scuola destinatario" required>
                <div className="flex flex-wrap gap-1.5">
                  {Object.entries(ORDINI).map(([k, v]) => <Chip key={k} label={v} selected={d.ordini.includes(k)} onClick={() => toggleIn("ordini", k)} />)}
                </div>
              </Field>
              <div className="grid grid-cols-2 gap-3">
                <Field label="Età minima (anni)">
                  <input className={INPUT} type="number" min="0" max="99" value={d.etaMin} onChange={e => upd("etaMin", e.target.value)} />
                </Field>
                <Field label="Età massima (anni)">
                  <input className={INPUT} type="number" min="0" max="99" value={d.etaMax} onChange={e => upd("etaMax", e.target.value)} />
                </Field>
              </div>
              {d.ordini.length > 0 && (
                <button type="button" onClick={usaEtaSuggerita}
                  className="text-xs text-teal-600 hover:underline">
                  Usa la fascia d'età tipica degli ordini selezionati
                </button>
              )}
            </div>
          )}

          {/* STEP 3 */}
          {step === 3 && (
            <div>
              <h2 className="text-xl font-bold text-teal-900 mb-5">Discipline e campi di esperienza</h2>
              {d.ordini.length === 0 && <p className="text-sm text-slate-400">Seleziona prima almeno un ordine di scuola (passaggio Destinatari).</p>}
              {hasInfanzia && (
                <div className="mb-5">
                  <p className="text-sm font-semibold text-slate-600 mb-2">{ORDINI.infanzia} — campi di esperienza</p>
                  <ChipPicker options={CAMPI_ESPERIENZA} selected={d.campi}
                    onToggle={c => toggleIn("campi", c)} onAdd={c => addUnique("campi", c)} placeholder="Altro campo non in elenco…" />
                </div>
              )}
              {ordiniConDiscipline.map(o => (
                <div key={o} className="mb-5">
                  <p className="text-sm font-semibold text-slate-600 mb-2">{ORDINI[o]}</p>
                  <ChipPicker options={DISCIPLINE[o] || []} selected={d.discipline[o] || []}
                    onToggle={dis => toggleDisc(o, dis)} onAdd={dis => addDisc(o, dis)} placeholder={`Altra disciplina per ${ORDINI[o]}…`} />
                </div>
              ))}
            </div>
          )}

          {/* STEP 4 */}
          {step === 4 && (
            <div>
              <h2 className="text-xl font-bold text-teal-900 mb-5">Metodologie e durata</h2>
              <div className="grid grid-cols-2 gap-3 mb-4">
                <Field label="Durata">
                  <input className={INPUT} type="number" min="1" value={d.durata} onChange={e => upd("durata", e.target.value)} />
                </Field>
                <Field label="Unità">
                  <select className={INPUT} value={d.durataUnita} onChange={e => upd("durataUnita", e.target.value)}>
                    <option>ore</option><option>lezioni</option><option>settimane</option><option>mesi</option>
                  </select>
                </Field>
              </div>
              <Field label="Metodologie didattiche coinvolte">
                <ChipPicker options={METODOLOGIE} selected={d.metodologie} suggested={suggMet}
                  onToggle={m => toggleIn("metodologie", m)} onAdd={m => addUnique("metodologie", m)} placeholder="Altra metodologia non in elenco…" />
              </Field>
              <Suggerimento title="Metodologie suggerite in base alla descrizione" items={suggMet} onPick={m => toggleIn("metodologie", m)} />
            </div>
          )}

          {/* STEP 5 */}
          {step === 5 && (
            <div>
              <h2 className="text-xl font-bold text-teal-900 mb-3">Competenze</h2>

              {suggCompetenzeNomi.length > 0 && (
                <div className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4">
                  <p className="font-semibold mb-1">✨ Competenze DigComp suggerite dall'analisi della descrizione</p>
                  <p className="mb-2">{suggCompetenzeNomi.join(" · ")}</p>
                  <button type="button" onClick={() => suggCompetenzeNomi.forEach(c => addUnique("digcomp", c))}
                    className="px-2.5 py-1 rounded-full bg-white border border-amber-300 hover:bg-amber-100">
                    Applica tutte
                  </button>
                </div>
              )}

              <p className="text-xs text-slate-400 mb-2">Le aree DigComp nel documento vengono ricavate automaticamente dalle competenze scelte.</p>
              {DIGCOMP.map((area, ai) => {
                const tutteSel = area.competenze.every(c => d.digcomp.includes(c));
                const areaSuggerita = suggCompetenze.some(code => code.startsWith(`${ai + 1}.`));
                return (
                  <div key={area.area} className={`mb-3 rounded-2xl border p-3.5 ${areaSuggerita ? "border-amber-200 bg-amber-50/50" : "border-teal-100 bg-white/60"}`}>
                    <div className="flex items-center justify-between gap-2 mb-2">
                      <span className="text-sm font-semibold text-slate-700">{area.area}</span>
                      <button type="button" className="text-xs text-teal-600 hover:underline whitespace-nowrap"
                        onClick={() => upd("digcomp", arr => tutteSel
                          ? arr.filter(c => !area.competenze.includes(c))
                          : [...arr, ...area.competenze.filter(c => !arr.includes(c))])}>
                        {tutteSel ? "Deseleziona area" : "Seleziona area"}
                      </button>
                    </div>
                    <div className="flex flex-wrap gap-1.5">
                      {area.competenze.map(c => (
                        <Chip key={c} label={c} selected={d.digcomp.includes(c)} highlight={suggCompetenzeNomi.includes(c)} onClick={() => toggleIn("digcomp", c)} />
                      ))}
                    </div>
                  </div>
                );
              })}
              {d.digcomp.filter(c => !TUTTE_COMPETENZE_DIGCOMP.includes(c)).length > 0 && (
                <div className="flex flex-wrap gap-1.5 mb-1">
                  {d.digcomp.filter(c => !TUTTE_COMPETENZE_DIGCOMP.includes(c)).map(c => (
                    <Chip key={c} label={c} selected={true} onClick={() => toggleIn("digcomp", c)} />
                  ))}
                </div>
              )}
              <AggiungiManuale placeholder="Competenza DigComp personalizzata…" onAdd={c => addUnique("digcomp", c)} />

              <h3 className="font-semibold text-teal-900/80 mt-6 mb-2">Competenze chiave per l'apprendimento permanente</h3>
              <ChipPicker options={COMPETENZE_CHIAVE} selected={d.competenzeChiave}
                onToggle={c => toggleIn("competenzeChiave", c)} onAdd={c => addUnique("competenzeChiave", c)} placeholder="Altra competenza chiave…" />

              <h3 className="font-semibold text-teal-900/80 mt-6 mb-2">Traguardi competenza digitale — Indicazioni Nazionali 2025</h3>
              <CheckList options={TRAGUARDI_DIGITALE} selected={d.traguardi}
                onToggle={t => toggleIn("traguardi", t)} onAdd={t => addUnique("traguardi", t)} placeholder="Altro traguardo (anche di altre discipline)…" />
            </div>
          )}

          {/* STEP 6 */}
          {step === 6 && (
            <div>
              <h2 className="text-xl font-bold text-teal-900 mb-3">Controlla e invia</h2>
              <p className="text-sm text-slate-500 mb-4">
                Verifica il documento, spunta le dichiarazioni sulla privacy e invia la tua buona pratica.
                I dati sono visibili solo ai referenti e alle referenti del progetto e alle persone da loro autorizzate.
              </p>

              {mancanti.length > 0 && (
                <p className="text-xs text-amber-800 bg-amber-50 border border-amber-200 rounded-lg p-2 mb-3">
                  Non ancora compilato: {mancanti.join(", ")}. Puoi tornare indietro dai passaggi in alto.
                </p>
              )}

              <details className="mb-4 rounded-2xl border border-teal-100 bg-white/60 p-3">
                <summary className="cursor-pointer text-sm font-medium text-teal-700">👀 Anteprima del documento (e copia personale)</summary>
                <div className="flex gap-2 flex-wrap my-3">
                  <button onClick={copia} className={BTN_SECONDARIO}>{copiato ? "✓ Copiato!" : "📋 Copia"}</button>
                  <button onClick={scarica} className={BTN_SECONDARIO}>⬇ Scarica .md</button>
                </div>
                {avviso && <p className="text-xs text-amber-700 bg-amber-50 border border-amber-200 rounded-lg p-2 mb-2">{avviso}</p>}
                <textarea id="doc-manuale" readOnly value={documento} onFocus={e => e.target.select()}
                  className="w-full h-56 bg-slate-800 text-teal-50 text-xs rounded-2xl p-4 overflow-auto font-mono border border-slate-700 shadow-inner" />
              </details>

              <div className="rounded-2xl bg-gradient-to-br from-rose-50/70 to-amber-50 border border-amber-200/80 p-4 mb-4">
                <h3 className="font-semibold text-teal-900/80 mb-3">🔒 Privacy e dati personali</h3>
                <label className="flex items-start gap-2 text-sm text-slate-700 cursor-pointer mb-3">
                  <input type="checkbox" className="mt-1 accent-teal-600" checked={d.consensoPrivacy} onChange={() => upd("consensoPrivacy", v => !v)} />
                  <span>
                    Dichiaro che le informazioni inserite <b>non contengono dati sensibili né dati personali</b> riferiti ad alunni e alunne, famiglie,
                    colleghi e colleghe o altre persone identificabili (nomi e cognomi, foto, video, registrazioni vocali, dati sulla salute, su disabilità o BES
                    di singoli, situazioni familiari, valutazioni individuali, codici fiscali, recapiti) e che non sono presenti materiali riservati.
                  </span>
                </label>
                <label className="flex items-start gap-2 text-sm text-slate-700 cursor-pointer">
                  <input type="checkbox" className="mt-1 accent-teal-600" checked={d.consensoInformativa} onChange={() => upd("consensoInformativa", v => !v)} />
                  <span>
                    Ho letto l'informativa e <b>acconsento al trattamento dei miei dati</b> (nome, cognome, email istituzionale, istituzione)
                    per la raccolta delle buone pratiche e per eventuali contatti da parte dei referenti e delle referenti del progetto.
                  </span>
                </label>
                <details className="text-xs text-slate-600 mt-3">
                  <summary className="cursor-pointer text-teal-700 font-medium">Leggi l'informativa privacy (v{VERSIONE_INFORMATIVA})</summary>
                  <div className="mt-2 space-y-1.5">
                    <p><b>Titolare del trattamento:</b> {TITOLARE}.</p>
                    <p><b>Responsabile della protezione dei dati (RPD):</b> {EMAIL_PRIVACY}.</p>
                    <p><b>Dati trattati:</b> autore/autrice, email istituzionale, istituzione scolastica e regione, insieme ai contenuti della scheda (titolo, abstract, descrizione, ordini di scuola, età, durata, discipline o campi di esperienza, metodologie e competenze).</p>
                    <p><b>Finalità:</b> raccolta e valorizzazione delle buone pratiche didattiche e contatti con chi ha inviato la scheda, da parte dei referenti e delle referenti del progetto.</p>
                    <p><b>Base giuridica:</b> consenso (art. 6, par. 1, lett. a, GDPR), revocabile in ogni momento senza pregiudicare la liceità del trattamento già effettuato.</p>
                    <p><b>Natura del conferimento:</b> facoltativo; senza i dati richiesti non è possibile inviare la scheda.</p>
                    <p><b>Accesso ai dati:</b> solo i referenti e le referenti del progetto e le persone da loro autorizzate. I dati non sono pubblicati né diffusi e non sono ceduti a terzi senza ulteriore consenso. Non è previsto alcun processo decisionale automatizzato.</p>
                    <p><b>Archiviazione:</b> foglio di calcolo ad accesso riservato, su servizi cloud di Google (Fogli e Apps Script).</p>
                    <p><b>Conservazione:</b> {CONSERVAZIONE}.</p>
                    <p><b>Diritti:</b> accesso, rettifica, cancellazione, limitazione, opposizione e revoca del consenso (artt. 15-22 GDPR), scrivendo al Titolare o al RPD ({EMAIL_PRIVACY}).</p>
                    <p><b>Reclamo:</b> è possibile proporre reclamo al Garante per la protezione dei dati personali (www.garanteprivacy.it).</p>
                  </div>
                </details>
              </div>

              {stato === "ok" ? (
                <div className="rounded-2xl bg-teal-50 border border-teal-200 p-4">
                  <p className="font-semibold text-teal-900 mb-1">✅ Grazie! La tua buona pratica è stata inviata.</p>
                  <p className="text-xs text-slate-600 mb-3">{msgInvio}</p>
                  <div className="flex gap-2 flex-wrap">
                    <button onClick={azzeraTutto} className={BTN_PRIMARIO}>Compila un'altra scheda</button>
                    <button onClick={() => setStato("")} className={BTN_SECONDARIO}>Modifica e reinvia</button>
                  </div>
                </div>
              ) : (
                <div>
                  {!ENDPOINT_INVIO && (
                    <p className="text-xs text-rose-600 bg-rose-50 border border-rose-200 rounded-lg p-2 mb-2">
                      Invio non ancora configurato: chi pubblica il wizard deve inserire l'URL dell'app web in <code>ENDPOINT_INVIO</code>.
                    </p>
                  )}
                  <button disabled={!puoInviare || stato === "invio" || !ENDPOINT_INVIO} onClick={invia} className={BTN_PRIMARIO}>
                    {stato === "invio" ? "Invio in corso…" : d.inviataIl ? "📨 Reinvia (aggiorna la scheda)" : "📨 Invia la buona pratica"}
                  </button>
                  {stato === "errore" && <p className="text-xs text-rose-600 mt-2" role="alert">{msgInvio}</p>}
                </div>
              )}

              <p className="text-[11px] text-slate-400 mt-5">
                La bozza è salvata solo in questo browser. Se stai usando un computer condiviso,{" "}
                <button type="button" onClick={azzeraTutto} className="underline hover:text-rose-500">cancella i dati da questo dispositivo</button>.
              </p>
            </div>
          )}

          {/* errori */}
          {errori[step].length > 0 && (
            <ul className="mt-4 text-xs text-rose-600 space-y-0.5" role="alert">
              {errori[step].map(e => <li key={e}>• {e}</li>)}
            </ul>
          )}

          {/* nav */}
          <div className="flex justify-between mt-8 pt-5 border-t border-teal-100/70">
            <button onClick={() => setStep(s => Math.max(0, s - 1))} disabled={step === 0}
              className="px-5 py-2 rounded-full text-sm text-teal-700 bg-white border border-teal-200 disabled:opacity-40 hover:bg-teal-50 transition-colors">← Indietro</button>
            {step < steps.length - 1
              ? <button onClick={() => validita[step] && setStep(s => s + 1)} disabled={!validita[step]}
                  className="px-6 py-2 rounded-full text-sm font-medium bg-gradient-to-r from-teal-500 to-emerald-500 text-white shadow-md shadow-teal-300/50 disabled:opacity-40 disabled:shadow-none hover:from-teal-600 hover:to-emerald-600 transition-all">Avanti →</button>
              : <span className="text-xs text-teal-600 self-center font-medium">Documento pronto ✨</span>}
          </div>
        </div>
      </div>
    </div>
  );
}
