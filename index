function Field({ label, children, hint, required }) {
  return (
    <div className="mb-4">
      <label className={LABEL}>{label}{required && <span className="text-rose-500"> *</span>}</label>
      {hint && <p className="text-xs text-slate-400 mb-1">{hint}</p>}
      {children}
    </div>
  );
}

function Chip({ label, selected, onClick, highlight }) {
  const stato = selected
    ? "bg-gradient-to-br from-teal-500 to-emerald-500 text-white border-transparent shadow-sm shadow-teal-300/60"
    : highlight
      ? "bg-amber-50 text-slate-700 border-amber-300 hover:border-teal-400"
      : "bg-white/90 text-slate-600 border-teal-100 hover:border-teal-300 hover:bg-teal-50";
  return (
    <button type="button" aria-pressed={selected} onClick={onClick}
      className={`px-3 py-1.5 rounded-full border text-xs font-medium transition-all ${stato}`}>
      {highlight && !selected && "✨ "}{label}
    </button>
  );
}

function AggiungiManuale({ onAdd, placeholder = "+ aggiungi a mano…" }) {
  const [val, setVal] = useState("");
  const conferma = () => {
    if (val.trim()) { onAdd(val.trim()); setVal(""); }
  };
  return (
    <div className="flex gap-1.5 mt-2">
      <input className={INPUT} value={val} onChange={e => setVal(e.target.value)} placeholder={placeholder}
        onKeyDown={e => { if (e.key === "Enter") { e.preventDefault(); conferma(); } }} />
      <button type="button" onClick={conferma}
        className="px-4 py-1.5 rounded-xl text-xs font-medium bg-teal-50 border border-teal-200 text-teal-700 hover:bg-teal-100 whitespace-nowrap">
        Aggiungi
      </button>
    </div>
  );
}

// Chip predefiniti + voci personalizzate già selezionate + campo per aggiungerne altre
function ChipPicker({ options, selected, onToggle, onAdd, placeholder, suggested = [] }) {
  const custom = selected.filter(s => !options.includes(s));
  return (
    <div>
      <div className="flex flex-wrap gap-1.5">
        {options.map(o => <Chip key={o} label={o} selected={selected.includes(o)} highlight={suggested.includes(o)} onClick={() => onToggle(o)} />)}
        {custom.map(o => <Chip key={o} label={o} selected={true} onClick={() => onToggle(o)} />)}
      </div>
      {onAdd && <AggiungiManuale placeholder={placeholder} onAdd={onAdd} />}
    </div>
  );
}

// Elenco a checkbox per voci lunghe (es. traguardi)
function CheckList({ options, selected, onToggle, onAdd, placeholder }) {
  const tutte = [...options, ...selected.filter(s => !options.includes(s))];
  return (
    <div>
      <ul className="space-y-1.5">
        {tutte.map(o => (
          <li key={o}>
            <label className="flex items-start gap-2 text-sm text-slate-700 cursor-pointer">
              <input type="checkbox" className="mt-1 accent-teal-600" checked={selected.includes(o)} onChange={() => onToggle(o)} />
              <span>{o}</span>
            </label>
          </li>
        ))}
      </ul>
      {onAdd && <AggiungiManuale placeholder={placeholder} onAdd={onAdd} />}
    </div>
  );
}

function Suggerimento({ items, onPick, title }) {
  if (!items.length) return null;
  return (
    <div className="mt-3 rounded-2xl bg-gradient-to-br from-amber-50 to-orange-50 border border-amber-200/70 p-3.5">
      <p className="text-xs font-semibold text-amber-800 mb-1.5">✨ {title}</p>
      <div className="flex flex-wrap gap-1.5">
        {items.map(it => (
          <button key={it} type="button" onClick={() => onPick(it)}
            className="px-2.5 py-1 rounded-full bg-white border border-amber-300 text-xs text-amber-800 hover:bg-amber-100">
            + {it}
          </button>
        ))}
      </div>
    </div>
  );
}

