      ["Ordine/i di scuola destinatario", d.ordini.map(o => ORDINI[o]).join(", ")],
      ["Età destinatari", etaMin !== null && etaMax !== null ? `${etaMin}–${etaMax} anni` : etaMin !== null ? `da ${etaMin} anni` : etaMax !== null ? `fino a ${etaMax} anni` : ""],
      ["Durata", d.durata ? `${d.durata} ${d.durataUnita}` : ""],
      ["Tag", d.tags.join(", ")],
    ].filter(([, v]) => String(v).trim());

    const sezioniDisc = d.ordini.map(o => {
      const voci = o === "infanzia" ? d.campi : d.discipline[o] || [];
      return `### ${ORDINI[o]}${o === "infanzia" ? " — campi di esperienza" : ""}\n\n${lista(voci)}`;
    }).join("\n\n");

    return `# ${d.titolo.trim() || "Titolo della buona pratica"}

## Dati generali

| Campo | Valore |
|---|---|
${righe.map(([k, v]) => `| ${k} | ${esc(v)} |`).join("\n")}

## Abstract

${d.abstract.trim() || "…"}

## Descrizione dell'attività

${d.descrizione.trim() || "…"}

## Discipline e campi di esperienza coinvolti

${sezioniDisc || "-"}

## Metodologie didattiche

${lista(d.metodologie)}

## Aree di competenza — DigComp 3.0

${lista(areeSelezionate.map(a => `**${a}**`))}

### Competenze specifiche

${lista(d.digcomp)}

## Competenze chiave per l'apprendimento permanente

${lista(d.competenzeChiave)}

## Traguardi per lo sviluppo delle competenze (Indicazioni Nazionali 2025)

${lista(d.traguardi)}
`;
  }, [d, etaMin, etaMax, areeSelezionate]);

  const mancanti = [
    !d.abstract.trim() && "abstract",
    !d.descrizione.trim() && "descrizione",
    d.metodologie.length === 0 && "metodologie",
    d.digcomp.length === 0 && "competenze DigComp",
