// restituisce "" se l'email è accettata, altrimenti il messaggio d'errore
function controllaEmailIstituzionale(email, istituzione) {
  const e = String(email || "").trim().toLowerCase();
  if (!e) return "Inserisci la tua email istituzionale.";
  const m = e.match(/^[a-z0-9._%+\-]+@([a-z0-9\-]+(?:\.[a-z0-9\-]+)+)$/);
  if (!m) return "L'indirizzo email non è valido.";
  const dominio = m[1];
  const parti = dominio.split(".");
  const rifiuto = "Email non accettata: usa un indirizzo istituzionale (@istruzione.it, dominio .edu / .edu.it, oppure il dominio .it del tuo istituto). Gli indirizzi personali o di provider pubblici non sono ammessi.";
  if (dominio === "istruzione.it" || dominio.endsWith(".istruzione.it")) return "";
  if (parti[parti.length - 1] === "edu" || dominio.endsWith(".edu.it")) return "";
  if (parti[parti.length - 1] === "it") {
    if (DOMINI_PUBBLICI.includes(parti.slice(-2).join("."))) return rifiuto;
    const etichetta = normalizza(parti[parti.length - 2]).replace(/[^a-z0-9]/g, "");
    const token = normalizza(istituzione).split(/[^a-z0-9]+/).filter(t => t.length >= 3 && !STOPWORD_ISTITUTO.includes(t));
    if (!token.length) return "Per verificare il dominio .it inserisci il nome completo dell'istituto nel campo «Istituzione scolastica».";
    if (token.some(t => etichetta.includes(t))) return "";
    return "Il dominio .it non richiama il nome dell'istituto indicato: controlla il campo «Istituzione scolastica» oppure usa un indirizzo @istruzione.it / .edu.";
  }
  return rifiuto;
}

// individua nel testo dati personali evidenti (non sostituisce la dichiarazione dell'autore)
function rilevaDatiPersonali(testo) {
  const t = String(testo || "");
  const trovati = [];
  if (/[a-z0-9._%+\-]+@[a-z0-9\-]+(\.[a-z0-9\-]+)+/i.test(t)) trovati.push("indirizzi email");
  if (/(?:\+39[\s.-]?)?\b3\d{2}[\s.-]?\d{6,7}\b|\b0\d{1,3}[\s.-]?\d{6,8}\b/.test(t)) trovati.push("numeri di telefono");
  if (/\b[A-Z]{6}\d{2}[A-EHLMPR-T]\d{2}[A-Z]\d{3}[A-Z]\b/i.test(t)) trovati.push("codici fiscali");
  return trovati;
}

